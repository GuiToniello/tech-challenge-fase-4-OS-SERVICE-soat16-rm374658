POSTGRES_DB=oficina_os
POSTGRES_USER=sa
POSTGRES_PASSWORD=P@ssw0rd123
POSTGRES_PORT=5433

API_OS_SERVICE_PORT=7195
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

ALLOWED_HOSTS=*
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_ASPNETCORE=Warning
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=oficina_os;Username=sa;Password=P@ssw0rd123

ELASTICMQ_PORT=9325
# Saga local com a Management e o Billing: os tres servicos precisam do mesmo ElasticMQ (o da Management).
# Use SQS_SERVICE_URL=http://oficina-elasticmq:9324 e, depois do "compose up", ligue o container a rede da Management
# (o Billing faz o mesmo com o container dele):
#   podman network connect tech-challenge-fase-4-management-soat16-rm374658_default oficina-os-service-api
# As filas de publicacao (Management e Billing) ficam fixas no docker-compose.yml (SqsSettings__FilasPublicacao__0 e __1).
SQS_SERVICE_URL=http://elasticmq:9324

REGISTRY_PREFIX=903936907231.dkr.ecr.us-east-1.amazonaws.com/
IMAGE_TAG=latest
